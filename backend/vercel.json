{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/automation/cron/daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/v1/automation/cron/weekly",
      "schedule": "0 0 * * 0"
    }
  ]
}
